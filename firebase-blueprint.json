{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "subscribedTo": { "type": "array", "items": { "type": "string" } },
        "watchHistory": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Video": {
      "title": "Video Content",
      "description": "Detailed metadata for both short and long form videos.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "url": { "type": "string" },
        "thumbnail": { "type": "string" },
        "type": { "type": "string", "enum": ["short", "long"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "views": { "type": "integer" },
            "likes": { "type": "integer" },
            "comments": { "type": "integer" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorId", "url", "type"]
    },
    "Message": {
      "title": "Direct Message",
      "description": "Private communication between users.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isRead": { "type": "boolean" }
      },
      "required": ["senderId", "content", "timestamp"]
    },
    "Comment": {
      "title": "Video Comment",
      "description": "User feedback on specific videos.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "likes": { "type": "integer" }
      },
      "required": ["userId", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Root collection for user profiles."
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Root collection for all video content."
    },
    "/videos/{videoId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Subcollection for video-specific discussions."
    },
    "/chats/{chatId}/messages/{msgId}": {
      "schema": "Message",
      "description": "Subcollection for private message threads."
    }
  }
}
